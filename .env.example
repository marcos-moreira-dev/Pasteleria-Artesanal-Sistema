SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080

DB_HOST=localhost
# PostgreSQL canónico local vía Docker: 5436
# PostgreSQL nativo alternativo: 5432
DB_PORT=5436
DB_NAME=pasteleria
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION_SECONDS=7200
JWT_ISSUER=pasteleria-backend

NOTIFICATION_DEFAULT_LIMIT=8
NOTIFICATION_ARCHIVE_READ_AFTER_DAYS=10
NOTIFICATION_ARCHIVE_CRON=0 0 3 * * *

REPORT_WORKER_ENABLED=true
REPORT_WORKER_DELAY_MS=15000
REPORT_WORKER_BATCH_SIZE=3
REPORT_RETENTION_DAYS=14
REPORT_CLEANUP_CRON=0 15 3 * * *
# dev usa ./storage; presentation usa ./storage-sit mediante scripts
APP_STORAGE_ROOT=./storage
REPORT_STORAGE_PATH=./storage/reportes

PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
API_BASE_URL=http://localhost:8080/api/v1
PUBLIC_SITE_URL=http://localhost:4321
ADMIN_SITE_URL=http://localhost:4200
